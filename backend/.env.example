APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://rehearse_ai:replace-me@127.0.0.1:5432/rehearse_ai
OPENROUTER_API_KEY=
GROQ_API_KEY=
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.rehearse-ai.sit.kmutt.ac.th
SLIDE_ANALYSIS_MODEL=openai/gpt-6-luna
TRANSCRIPT_MODEL=openai/gpt-6-luna
UPLOAD_PRACTICE_POSE_MODEL=yolo11n-pose.pt
UPLOAD_PRACTICE_TRANSCRIPTION_MODEL=elevenlabs/scribe-v2
# Optional comma-separated caution terms for uploaded-practice transcripts.
UPLOAD_PRACTICE_SENSITIVE_TERMS=
UPLOAD_PRACTICE_CPU_THREADS=0
SLIDE_VISION_WORKERS=4
SLIDE_ANALYSIS_WORKERS=5
SLIDE_ANALYSIS_BATCH_SIZE=3
# Maximum concurrent slide requests during bulk transcript generation.
TRANSCRIPT_GENERATION_WORKERS=4

# Close D-Day guest entry and invalidate guest access after the event.
GUEST_ACCESS_ENABLED=true
# A completed Upload Practice report UUID selected as the guest read-only sample.
GUEST_PRACTICE_SAMPLE_ID=
