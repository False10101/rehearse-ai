# Runtime
APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Authentication (replace before any shared or production deployment)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# Future infrastructure integrations
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Configurable product defaults
SLIDE_ANALYSIS_MODEL=openai/gpt-6-luna
TRANSCRIPT_MODEL=openai/gpt-6-luna
WHISPER_MODEL=whisper-large-v3-turbo
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
